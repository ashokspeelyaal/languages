# Comma-separated user:password pairs. First boot seeds them into the DB
# (bcrypt-hashed). After first boot you can remove these from the file —
# only the bcrypt hashes in SQLite are used for authentication.
USERS=ashok:change-me

# OpenAI key — used for chat completions, TTS, Whisper STT, GPT-5 vision OCR.
OPENAI_API_KEY=sk-...

# Azure Speech (optional — only needed if you want Vlaams voices).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Random 32+ char string. Cookies are signed with this; rotating it logs everyone out.
SESSION_SECRET=replace-with-32-or-more-random-characters

# Paths (defaults are fine for local + Hetzner).
DATABASE_PATH=./data/b2vocab.db
AUDIO_DIR=./data/audio
SEEDS_DIR=./seeds

# Where the frontend is served from. Leave blank for same-origin.
ALLOWED_ORIGIN=

# Soft cap per user per day on AI calls (transparency only — never blocks).
AI_SOFT_LIMIT=50

# Bind address + port for uvicorn.
HOST=127.0.0.1
PORT=8000
