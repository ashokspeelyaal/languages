[Unit]
Description=Studeerkamer — Nederlands B2->C1 trainer
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/studeerkamer
EnvironmentFile=/opt/studeerkamer/.env
ExecStart=/opt/studeerkamer/.venv/bin/python -m uvicorn server.main:app --host 127.0.0.1 --port 15191 --workers 1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=studeerkamer

[Install]
WantedBy=multi-user.target
